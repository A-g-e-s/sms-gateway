{
    "name": "ages/sms-gateway",
    "description": "Unified SMS gateway API (sending text messages) – SmsManager",
    "type": "library",
    "require": {
        "php": ">=8.4",
        "guzzlehttp/guzzle": "^7.9",
        "brick/phonenumber": "^0.8"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Ages\\SmsGateway\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "phpstan": "phpstan analyse"
    }
}
